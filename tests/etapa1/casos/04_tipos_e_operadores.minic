int contador = 0;
float pi = 3.14;
bool ativo = true;
char inicial = 'M';
char nova_linha = '\n';

int operadores(int a, int b) {
    int soma = a + b;
    int sub = a - b;
    int mul = a * b;
    int div = a / b;
    int resto = a % b;
    bool igual = a == b;
    bool diferente = a != b;
    bool menor = a < b;
    bool maior = a > b;
    bool menor_igual = a <= b;
    bool maior_igual = a >= b;
    bool e_logico = (a > 0) && (b > 0);
    bool ou_logico = (a > 0) || (b > 0);
    bool negacao = !ativo;
    int negativo = -a;
    return soma - sub + mul - div - resto;
}

void imprime_mensagem() {
    print("resultado calculado");
}

int main() {
    while (contador < 3) {
        if (contador == 1) {
            continue;
        }
        if (contador == 2) {
            break;
        }
        contador = contador + 1;
    }
    imprime_mensagem();
    return 0;
}
